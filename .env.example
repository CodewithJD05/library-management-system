APP_NAME=Library Management System API
DEBUG=false
SECRET_KEY=replace_with_a_random_secret
DATABASE_URL=postgresql+psycopg://your_library_user:your_password@localhost:your_port/your_database_name
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500"]
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Access/session policy
REFRESH_TOKEN_EXPIRE_DAYS=7
RESERVATION_HOLD_HOURS=48
STUDENT_DAILY_FINE=10
FACULTY_DAILY_FINE=5
LIBRARY_TIMEZONE=Asia/Kolkata
REMINDER_DAYS_BEFORE=1
# SMTP: leave empty to queue notifications without sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
